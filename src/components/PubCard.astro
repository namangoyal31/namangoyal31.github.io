---
import type { Publication } from '../data/publications';
import { site } from '../data/site';
import { renderRich } from '../lib/rich';

interface Props {
  pub: Publication;
  /** Show the full abstract (publications page) vs summary (home teaser). */
  full?: boolean;
}

const { pub, full = false } = Astro.props;
const absUrl = pub.arxiv ? `https://arxiv.org/abs/${pub.arxiv}` : undefined;
const pdfUrl = pub.arxiv ? `https://arxiv.org/pdf/${pub.arxiv}` : undefined;

const bibtex = `@article{goyal2026pseudoNewtonian,
  title   = {Tests of general relativity in pseudo-Newtonian approach},
  author  = {Goyal, Naman and Mukhopadhyay, Banibrata and Meena, Ashish Kumar},
  journal = {arXiv e-prints},
  eprint  = {${pub.arxiv}},
  archivePrefix = {arXiv},
  primaryClass  = {${pub.arxivCategory}},
  year    = {${pub.year}}
}`;
---
<article class="pub-card" id={pub.id}>
  <p class="meta">
    <span class="status-dot published" aria-hidden="true"></span>
    {pub.status === 'preprint' ? 'Preprint' : pub.venue ?? 'Published'} · {pub.year}
  </p>
  <h3>
    {absUrl ? <a href={absUrl} target="_blank" rel="noopener noreferrer">{pub.title}</a> : pub.title}
  </h3>
  <p class="authors meta">
    {
      pub.authors.map((a, i) => (
        <>
          {i > 0 && ', '}
          {a.me ? <strong>{a.name}</strong> : a.name}
        </>
      ))
    }
  </p>
  <p class="meta">{pub.area}</p>
  {
    full ? (
      <>
        <p class="pub-abstract">{pub.abstract}</p>
        {pub.description && (
          <div class="prose" style="margin-top: 1.4rem;">
            {pub.description.map((para) => <p set:html={renderRich(para)} />)}
          </div>
        )}
      </>
    ) : (
      <p class="pub-abstract">{pub.summary}</p>
    )
  }
  {
    absUrl && (
      <div class="pub-links">
        <a class="chip" href={absUrl} target="_blank" rel="noopener noreferrer">arXiv:{pub.arxiv} · abstract</a>
        {pdfUrl && <a class="chip" href={pdfUrl} target="_blank" rel="noopener noreferrer">PDF</a>}
      </div>
    )
  }
  {
    full && (
      <details class="bibtex">
        <summary>BibTeX</summary>
        <pre id={`bibtex-${pub.id}`}>{bibtex}</pre>
      </details>
      <button class="copy-btn" type="button" data-copy={`bibtex-${pub.id}`}>Copy BibTeX</button>
    )
  }
</article>

<script>
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const pre = document.getElementById(btn.getAttribute('data-copy') ?? '');
      if (!pre) return;
      let ok = false;
      try {
        await navigator.clipboard.writeText(pre.textContent ?? '');
        ok = true;
      } catch (e) {
        // clipboard API unavailable (permissions / older engines): fall
        // back to the classic selected-text copy
        const ta = document.createElement('textarea');
        ta.value = pre.textContent ?? '';
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try { ok = document.execCommand('copy'); } catch (e2) { ok = false; }
        ta.remove();
      }
      btn.textContent = ok ? 'Copied' : 'Select and copy manually';
      setTimeout(() => {
        btn.textContent = 'Copy BibTeX';
      }, 1600);
    });
  });
</script>
