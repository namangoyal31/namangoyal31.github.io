---
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import PubCard from '../components/PubCard.astro';
import { site } from '../data/site';
import { projects } from '../data/projects';
import { publications } from '../data/publications';
import { timeline } from '../data/timeline';
import { renderRich } from '../lib/rich';

const current = projects.filter((p) => p.status === 'current');
const selected = projects.filter((p) => !p.experimental && p.status !== 'current');
const pub = publications[0];

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  email: `mailto:${site.email}`,
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: 'Indian Institute of Science',
  },
  jobTitle: 'Undergraduate researcher in theoretical physics',
  sameAs: [site.github, 'https://arxiv.org/abs/2602.20261'],
};
---
<Base
  title={site.name}
  description="Naman Goyal, B.S. (Research) physics undergraduate at IISc Bengaluru. Theoretical high-energy physics and mathematical physics: scattering amplitudes and the S-matrix bootstrap, electroweak vacuum stability, and effective descriptions of gravitation."
  jsonLd={[personSchema]}
>
  <section class="hero">
    <canvas class="hero-field" aria-hidden="true"></canvas>
    <div class="container">
      <div class="hero-inner">
        <p class="eyebrow">Theoretical Physics · High Energy Theory</p>
        <h1>{site.name}</h1>
        <p class="affiliation">
          {site.role}, {site.institution}. Currently at TIFR, Mumbai, on scattering amplitudes
          and the S-matrix bootstrap.
        </p>
        <p class="lede">
          I work in theoretical high-energy physics and mathematical physics. Most of my research
          asks what quantum field theory and symmetry principles fix, and what they leave free:
          how much of general relativity survives in Newtonian form, how precisely semiclassical
          methods determine the stability of the Standard Model vacuum, and whether scattering
          amplitudes are pinned down by analyticity, crossing symmetry, unitarity, and Regge
          behavior.
        </p>
        <div class="cta-row">
          <a class="btn btn-solid" href="/research/">Research</a>
          <a class="btn btn-ghost" href={site.cvPath}>CV (PDF)</a>
          <a class="btn btn-ghost" href={site.github} rel="me">GitHub</a>
        </div>
        <p class="now-line">
          <strong>now</strong> · S-matrix bootstrap at TIFR · preprint on classical tests of GR,
          <a href="https://arxiv.org/abs/2602.20261">arXiv:2602.20261</a>
        </p>
      </div>
    </div>
  </section>

  <script>
    import { mountAmpField } from '../lib/amp-field.js';
    const canvas = document.querySelector('.hero-field');
    if (canvas) mountAmpField(canvas);
  </script>

  <section class="section" aria-labelledby="current-heading">
    <div class="container">
      <div class="section-head">
        <span class="secno">§ 01</span>
        <h2 id="current-heading">Current research</h2>
      </div>
      <ul class="row-list">
        {
          current.map((p) => (
            <li>
              <span class="row-no">01</span>
              <div>
                <p class="meta">
                  <span class="status-dot current" aria-hidden="true"></span>
                  ongoing · {p.period} · {p.mentors} · {p.place}
                </p>
                <p class="row-title"><a href={`/research/#${p.id}`}>{p.title}</a></p>
                <p class="row-excerpt" set:html={renderRich(p.summary)} />
                <span class="row-link"><a href={`/research/#${p.id}`}>read more →</a></span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section-tight" aria-labelledby="selected-heading">
    <div class="container">
      <div class="section-head">
        <span class="secno">§ 02</span>
        <h2 id="selected-heading">Selected research</h2>
        <span style="flex:1"></span>
        <a class="smallcaps" href="/research/">all research →</a>
      </div>
      <ul class="row-list">
        {
          selected.map((p, i) => (
            <li>
              <span class="row-no">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <p class="row-meta meta">
                  {p.period} · {p.mentors} · {p.place}
                </p>
                <p class="row-title"><a href={`/research/#${p.id}`}>{p.shortTitle ?? p.title}</a></p>
                <p class="row-excerpt" set:html={renderRich(p.summary.split('.')[0] + '.')} />
                <span class="row-link"><a href={`/research/#${p.id}`}>read more →</a></span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section-tight" aria-labelledby="timeline-heading">
    <div class="container">
      <div class="section-head">
        <span class="secno">§ 03</span>
        <h2 id="timeline-heading">Chronology</h2>
        <span style="flex:1"></span>
        <a class="smallcaps" href="/research/#chronology">full timeline →</a>
      </div>
      <Timeline items={[...timeline].reverse().slice(0, 5).reverse()} />
    </div>
  </section>

  <section class="section section-tight" aria-labelledby="pub-heading">
    <div class="container">
      <div class="section-head">
        <span class="secno">§ 04</span>
        <h2 id="pub-heading">Publication</h2>
        <span style="flex:1"></span>
        <a class="smallcaps" href="/publications/">publications →</a>
      </div>
      <PubCard pub={pub} />
    </div>
  </section>
</Base>
