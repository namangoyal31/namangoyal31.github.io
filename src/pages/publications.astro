---
import Base from '../layouts/Base.astro';
import Divider from '../components/Divider.astro';
import PubCard from '../components/PubCard.astro';
import { site, personNode } from '../data/site';
import { publications } from '../data/publications';

const articles = publications.filter((p) => p.status === 'published');
const preprints = publications.filter((p) => p.status === 'preprint');

const articleSchema = publications.map((pub) => ({
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: pub.title,
  name: pub.title,
  abstract: pub.abstract,
  author: pub.authors.map((a) =>
    a.me
      ? personNode
      : { '@type': 'Person', name: a.name, affiliation: { '@type': 'CollegeOrUniversity', name: 'Indian Institute of Science' } }
  ),
  datePublished: pub.published ?? pub.submitted,
  ...(pub.journal && {
    isPartOf: {
      '@type': 'PublicationIssue',
      issueNumber: pub.journal.issue,
      isPartOf: {
        '@type': 'PublicationVolume',
        volumeNumber: pub.journal.volume,
        isPartOf: { '@type': 'Periodical', name: pub.journal.name, issn: pub.journal.issn },
      },
    },
    pagination: pub.journal.article,
    publisher: { '@type': 'Organization', name: pub.journal.publisher },
    url: pub.journal.url,
  }),
  ...(pub.doi && {
    identifier: { '@type': 'PropertyValue', propertyID: 'DOI', value: pub.doi },
    sameAs: [`https://doi.org/${pub.doi}`, ...(pub.arxiv ? [`https://arxiv.org/abs/${pub.arxiv}`] : [])],
  }),
  ...(pub.license && { license: pub.license.url, isAccessibleForFree: true }),
}));
---
<Base
  title="Publications"
  description="Publications of Naman Goyal: Tests of general relativity in pseudo-Newtonian approach, Eur. Phys. J. C 86, 1280 (2026), with B. Mukhopadhyay and A. K. Meena. Abstract, links, and BibTeX."
  jsonLd={articleSchema}
  ogImage="/og/publications.png"
>
  <div class="container">
    <header class="page-head">
      <p class="eyebrow">Publications</p>
      <h1>Publications</h1>
      <p class="lede prose" style="margin-top: 1.2rem;">
        Peer-reviewed work and preprints, newest first. Research software (SMVac) is listed
        below; ongoing projects are described under <a href="/research/">Research</a>.
      </p>
    </header>

    {
      articles.length > 0 && (
        <section class="section" aria-labelledby="articles-heading">
          <Divider poles={[0.3, 0.7]} />
          <div class="section-head">
            <span class="secno">01</span>
            <h2 id="articles-heading">Journal articles</h2>
          </div>
          {articles.map((p) => <PubCard pub={p} full />)}
        </section>
      )
    }

    {
      preprints.length > 0 && (
        <section class="section" aria-labelledby="preprints-heading">
          <div class="section-head">
            <span class="secno">{articles.length > 0 ? '02' : '01'}</span>
            <h2 id="preprints-heading">Preprints</h2>
          </div>
          {preprints.map((p) => <PubCard pub={p} full />)}
        </section>
      )
    }

    <section class="section section-tight" aria-labelledby="software-heading">
      <div class="section-head">
        <span class="secno">{String(Number(articles.length > 0) + Number(preprints.length > 0) + 1).padStart(2, '0')}</span>
        <h2 id="software-heading">Research software</h2>
      </div>
      <article class="card" style="max-width: 46rem;">
        <p class="meta">
          <span class="status-dot published" aria-hidden="true"></span>
          Research code · C++14 / Python · 2026
        </p>
        <h3 style="margin-top: 0;"><a href={site.smvac} target="_blank" rel="noopener noreferrer">SMVac: Standard Model electroweak vacuum stability — analytical approximations versus a numerical reference</a></h3>
        <p>
          Solves the tree-level bounce of the RG-improved Standard Model potential numerically, with a
          validated uncertainty, and uses it to test the analytical approximations to the vacuum decay
          action, with phase diagrams of the Higgs–top mass plane.
        </p>
        <span class="card-link"><a href="/smvac/">Project page →</a></span>
      </article>
    </section>
  </div>
</Base>
