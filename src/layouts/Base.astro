---
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { site, profiles } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** JSON-LD structured data object(s) for this page. */
  jsonLd?: object[];
  /** Relative path for og:image; omit if the page has no image. */
  ogImage?: string;
}

const { title, description, jsonLd = [], ogImage = '/og-image.png' } = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const ogUrl = new URL(ogImage, site.url).href;
const pageTitle = title === site.name ? `${site.name} · Theoretical Physics` : `${title} · ${site.name}`;

const navLinks = [
  { href: '/research/', label: 'Research' },
  { href: '/smvac/', label: 'SMVac' },
  { href: '/publications/', label: 'Publications' },
  { href: '/cv/', label: 'CV' },
  { href: '/about/', label: 'About' },
];

const normalize = (p: string) => (p.length > 1 ? p.replace(/\/$/, '') : p);
const currentPath = normalize(Astro.url.pathname);
const isCurrent = (href: string) => currentPath === normalize(href);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>document.documentElement.classList.add('js');</script>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogUrl} />}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogUrl} />}

    {
      jsonLd.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
  </head>
  <body>
    <div class="atmosphere" aria-hidden="true"><div class="atmosphere-grid"></div></div>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header" id="site-header">
      <div class="container">
        <a class="site-title" href="/">{site.name}</a>
        <div class="nav-wrap">
          <nav aria-label="Main">
            <ul class="nav-links" id="nav-links">
              {
                navLinks.map((link) => (
                  <li>
                    <a href={link.href} aria-current={isCurrent(link.href) ? 'true' : undefined}>
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <button class="icon-btn nav-toggle" id="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="nav-links">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path class="icon-bars" d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <h4>{site.name}</h4>
            <p>
              {site.role}, {site.institution}.<br />
              Theoretical high-energy physics and mathematical physics.
            </p>
            <p>
              <a href={`mailto:${site.email}`}>{site.email}</a>
            </p>
          </div>
          <div>
            <h4>Navigate</h4>
            <ul>
              {
                navLinks.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))
              }
            </ul>
          </div>
          <div>
            <h4>Elsewhere</h4>
            <ul>
              <li><a href={site.github} rel="me">GitHub · {site.githubUser}</a></li>
              <li><a href="https://arxiv.org/abs/2602.20261">arXiv</a></li>
              {profiles.map((p) => (
                <li><a href={p.url} rel="me">{p.label}</a></li>
              ))}
            </ul>
          </div>
        </div>
        <div class="colophon">
          <span>© 2026 {site.name}</span>
          <span>Last updated {site.lastUpdated}</span>
        </div>
      </div>
    </footer>

    <script>
      // Mobile navigation
      const header = document.getElementById('site-header');
      const navToggle = document.getElementById('nav-toggle');
      const setMenu = (open: boolean) => {
        header?.classList.toggle('nav-open', open);
        navToggle?.setAttribute('aria-expanded', String(open));
        navToggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      };
      navToggle?.addEventListener('click', () => {
        setMenu(!header?.classList.contains('nav-open'));
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setMenu(false);
      });
      document.getElementById('nav-links')?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) setMenu(false);
      });

      // Controlled reveals: sections enter once, staggered by markup order.
      const revealables = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed');
              io.unobserve(entry.target);
            }
          }
        }, { threshold: 0.12 });
        revealables.forEach((el) => io.observe(el));
      } else {
        revealables.forEach((el) => el.classList.add('revealed'));
      }

      // Easter egg: G toggles the underlying complex-plane grid.
      document.addEventListener('keydown', (e) => {
        if (e.key.toLowerCase() !== 'g' || e.metaKey || e.ctrlKey || e.altKey) return;
        const target = e.target as HTMLElement;
        if (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable) return;
        document.body.classList.toggle('show-grid');
      });
    </script>
  </body>
</html>
