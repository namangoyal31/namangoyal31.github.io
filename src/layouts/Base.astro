---
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { site, profiles } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** JSON-LD structured data object(s) for this page. */
  jsonLd?: object[];
  /** Relative path for og:image; omit if the page has no image. */
  ogImage?: string;
}

const { title, description, jsonLd = [], ogImage = '/og-image.png' } = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const ogUrl = new URL(ogImage, site.url).href;
const pageTitle = title === site.name ? `${site.name} · Theoretical Physics` : `${title} · ${site.name}`;

const navLinks = [
  { href: '/research/', label: 'Research' },
  { href: '/smvac/', label: 'SMVac' },
  { href: '/publications/', label: 'Publications' },
  { href: '/cv/', label: 'CV' },
  { href: '/about/', label: 'About' },
];

const normalize = (p: string) => (p.length > 1 ? p.replace(/\/$/, '') : p);
const currentPath = normalize(Astro.url.pathname);
const isCurrent = (href: string) => currentPath === normalize(href);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // Theme before first paint. Two states only: dark (the default, no
      // attribute needed) and light (an explicitly saved choice).
      try {
        if (localStorage.getItem('theme') === 'light') {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      } catch (e) {}
    </script>
    <script is:inline>document.documentElement.classList.add('js');</script>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogUrl} />}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogUrl} />}

    {
      jsonLd.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
  </head>
  <body>
    <div class="atmosphere" aria-hidden="true"><div class="atmosphere-grid"></div><div class="atmosphere-grid-accent"></div><div class="atmosphere-glow"></div></div>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header" id="site-header">
      <div class="container">
        <a class="site-title" href="/">{site.name}</a>
        <div class="nav-wrap">
          <nav aria-label="Main">
            <ul class="nav-links" id="nav-links">
              {
                navLinks.map((link) => (
                  <li>
                    <a href={link.href} aria-current={isCurrent(link.href) ? 'true' : undefined}>
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <button class="icon-btn" id="theme-toggle" type="button" aria-label="Switch color theme" title="Switch color theme">
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4.4"></circle>
              <path d="M12 2.5v2.4M12 19.1v2.4M2.5 12h2.4M19.1 12h2.4M4.9 4.9l1.7 1.7M17.4 17.4l1.7 1.7M19.1 4.9l-1.7 1.7M6.6 17.4l-1.7 1.7"></path>
            </svg>
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20.2 14.2A8.3 8.3 0 0 1 9.8 3.8a8.3 8.3 0 1 0 10.4 10.4Z"></path>
            </svg>
          </button>
          <button class="icon-btn nav-toggle" id="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="nav-links">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path class="icon-bars" d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <h4>{site.name}</h4>
            <p>
              {site.role}, {site.institution}.<br />
              Theoretical high-energy physics and mathematical physics.
            </p>
            <p>
              <a href={`mailto:${site.email}`}>{site.email}</a>
            </p>
          </div>
          <div>
            <h4>Navigate</h4>
            <ul>
              {
                navLinks.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))
              }
            </ul>
          </div>
          <div>
            <h4>Elsewhere</h4>
            <ul>
              <li><a href={site.github} rel="me noopener noreferrer" target="_blank">GitHub · {site.githubUser}</a></li>
              <li><a href="https://arxiv.org/abs/2602.20261" target="_blank" rel="noopener noreferrer">arXiv</a></li>
              {profiles.map((p) => (
                <li><a href={p.url} rel="me noopener noreferrer" target="_blank">{p.label}</a></li>
              ))}
            </ul>
          </div>
        </div>
        <div class="colophon">
          <span>© 2026 {site.name}</span>
          <span>Last updated {site.lastUpdated}</span>
        </div>
      </div>
    </footer>

    <script>
      // Mobile navigation
      const header = document.getElementById('site-header');
      const navToggle = document.getElementById('nav-toggle');
      const setMenu = (open: boolean) => {
        header?.classList.toggle('nav-open', open);
        navToggle?.setAttribute('aria-expanded', String(open));
        navToggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      };
      navToggle?.addEventListener('click', () => {
        setMenu(!header?.classList.contains('nav-open'));
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setMenu(false);
      });
      document.getElementById('nav-links')?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) setMenu(false);
      });

      // Controlled reveals: sections enter once, staggered by markup order.
      // Elements already inside the first viewport reveal immediately; only
      // below-fold content depends on the observer.
      const revealables = document.querySelectorAll('.reveal');
      const vh = window.innerHeight;
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed');
              io.unobserve(entry.target);
            }
          }
        }, { threshold: 0.12 });
        revealables.forEach((el) => {
          if (el.getBoundingClientRect().top < vh * 0.92) el.classList.add('revealed');
          else io.observe(el);
        });
      } else {
        revealables.forEach((el) => el.classList.add('revealed'));
      }

      // Easter egg: G intensifies the underlying complex-plane grid.
      document.addEventListener('keydown', (e) => {
        if (e.key.toLowerCase() !== 'g' || e.metaKey || e.ctrlKey || e.altKey) return;
        const target = e.target as HTMLElement;
        if (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable) return;
        document.body.classList.toggle('show-grid');
      });

      // Theme toggle: two states only, dark (default) and light. The
      // choice persists; a fresh visit without a saved preference is dark.
      const themeToggle = document.getElementById('theme-toggle');
      themeToggle?.addEventListener('click', () => {
        const light = document.documentElement.getAttribute('data-theme') === 'light';
        if (light) document.documentElement.removeAttribute('data-theme');
        else document.documentElement.setAttribute('data-theme', 'light');
        try {
          localStorage.setItem('theme', light ? 'dark' : 'light');
        } catch (e) {}
      });

      // Printing: expand collapsed sections (e.g. coursework) for the paper.
      window.addEventListener('beforeprint', () => {
        document.querySelectorAll('details').forEach((d) => {
          if (!(d as HTMLDetailsElement).open) {
            d.dataset.wasClosed = '1';
            (d as HTMLDetailsElement).open = true;
          }
        });
      });
      window.addEventListener('afterprint', () => {
        document.querySelectorAll('details[data-was-closed]').forEach((d) => {
          (d as HTMLDetailsElement).open = false;
          delete d.dataset.wasClosed;
        });
      });

      // Cursor-proximity illumination: the analytic plane brightens very
      // slightly around the pointer. Lerp in rAF (self-stopping); skipped
      // for touch devices and reduced motion.
      const glow = document.querySelector('.atmosphere-glow');
      const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (glow && finePointer && !calm) {
        let tx = innerWidth * 0.72, ty = innerHeight * 0.38;
        let x = tx, y = ty, raf = 0, running = false;
        const step = () => {
          x += (tx - x) * 0.045;
          y += (ty - y) * 0.045;
          glow.style.transform = `translate3d(${x.toFixed(1)}px, ${y.toFixed(1)}px, 0)`;
          if (Math.abs(tx - x) + Math.abs(ty - y) > 0.4) raf = requestAnimationFrame(step);
          else running = false;
        };
        const kick = () => {
          if (!running) {
            running = true;
            raf = requestAnimationFrame(step);
          }
        };
        window.addEventListener('pointermove', (e) => {
          tx = e.clientX;
          ty = e.clientY;
          kick();
        }, { passive: true });
        kick();
      }
    </script>
  </body>
</html>
